	.data			#them check empty trong phan check_pop
#TN2, D:
diem_ca_nhan: .word 6, 3, 8, 9, 2, 5, 7, 2, 6, 9, 4, 3
grade_tab: .byte 0, 0, 0, 0, 1, 1, 1, 2, 2, 3, 3
	.align 2
hist: .word 0x00000000, 0x00000000, 0x00000000, 0x00000000

min: .asciiz "min="
max: .asciiz "max="
g0: .asciiz "g0="
g1: .asciiz "g1="
g2: .asciiz "g2="
g3: .asciiz "g3="
#TN3, D:
P: .asciiz "([{}])"
P1: .asciiz "(a+b)*[c-{d/e}]"
P2: .asciiz "f(x[i]{j}))"
P3: .asciiz "{[(])}"
P4: .asciiz "((a)"
P5: .asciiz ""
P6: .asciiz "no brackets here"
P7: .asciiz "]"
P8: .asciiz "([)]"
loi: .asciiz "Loi: "
vitri: .asciiz "Vi tri: "
	.text
#min / max
	la $a0, diem_ca_nhan
	addi $a1, $zero, 12	#n phan tu
	jal stats
	#min=<>
	move $s0, $v0
	move $s1, $v1
	la $a0,min
	li $v0, 4
	syscall
	move $a0, $s0
	li $v0, 1
	syscall
	li $a0, 32
	li $v0, 11
	syscall
	#max=<>
	la $a0, max
	li $v0, 4
	syscall
	move $a0, $s1
	li $v0, 1
	syscall
	li $a0, 10
	li $v0, 11
	syscall
#goi histogram
	la $a0, diem_ca_nhan
	addi $a1, $zero, 12	#n=12
	la $a2, grade_tab
	la $a3, hist
	jal histo
	#go=<>
	la $s0, hist 
	li $v0, 4
	la $a0, g0
	syscall
	li $v0, 1
	lw $a0, 0($s0)
	syscall
	li $v0 11
	li $a0, 32
	syscall
	#g1=<>
	la $s0, hist 
	li $v0, 4
	la $a0, g1
	syscall
	li $v0, 1
	lw $a0, 4($s0)
	syscall
	li $v0 11
	li $a0, 32
	syscall
	#g2=<>
	la $s0, hist 
	li $v0, 4
	la $a0, g2
	syscall
	li $v0, 1
	lw $a0, 8($s0)
	syscall
	li $v0 11
	li $a0, 32
	syscall
	#g3=<>
	la $s0, hist 
	li $v0, 4
	la $a0, g3
	syscall
	li $v0, 1
	lw $a0, 12($s0)
	syscall
