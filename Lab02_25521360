#stats:
#input: $a0= arr address, $a1= so phan tu, 
#output: $v0= min, $v1= max
stats:
	subi $t0, $a1,1	#i=n-1
	lw $v0, 0($a0)
	lw $v1, 0($a0)
loop1:
	beq $t0,$zero, end_stats
	addi $a0, $a0, 4
	subi $t0, $t0, 1
	lw $t2, 0($a0)
	bgt $v1,$t2,next	#if (x>max): max=x
	move $v1,$t2
next:	blt $v0, $t2, loop1	#if (x<min): min=x
	move $v0, $t2
	j loop1
end_stats:
	jr $ra

#histogram:
#input: $a0 = ð?a ch? m?ng ði?m, $a1 = n, $a2 = ð?a ch? grade_tab, $a3 = ð?a ch? hist
#output: khong co 	
histo: 
	move $t0, $a1	#i=n
loop2:
	beq $t0, $zero, end_hist
	lw $t1, 0($a0)
	add $t2, $t1,$a2	#$t2= address (s)grade_tab
	lbu $t2, 0($t2)		#$t2= grade_tab[s]
	sll $t2, $t2 ,2		#byte x4
	add $t2, $t2, $a3	#$t2= address (grade_tab[s])hist
	lw $t3, 0($t2)		#$t3= hist[grade_tab[s]]
	addi $t3, $t3, 1	#hist[grade_tab[s]] ++
	sw $t3, 0($t2) 		#store hist[grade_tab[s]] m?i
	
	addi $a0, $a0, 4
	subi $t0, $t0, 1	#i--
	j loop2
end_hist:
	jr $ra

#check_brackets:
#input: $a0 = dia chi chuoi .asciiz 
#output: $v0 = vi tri, $v1 = ma loi theo B?ng 15.
check_brackets:
	addi $v0, $zero, 0 	#vitri=0
	addi $v1, $zero, 0	#chuoi hop le
	move $t0, $sp		#luu vi tri stack bat dau
loop3:
	lbu $t1, 0($a0)
	addi $v0, $v0, 1
	beq $t1, $zero, check_empty
	addi $a0, $a0, 1
	
	bne $t1,40,check1	#push (
	addi $sp, $sp, -4
	sw $t1, 0($sp)
	j loop3
check1:
	bne $t1,91,check2	#push [
	addi $sp, $sp, -4
	sw $t1, 0($sp)
	j loop3
check2:
	bne $t1,123,check_pop	#push {
	addi $sp, $sp, -4
	sw $t1, 0($sp)
	j loop3
check_pop:
	lw $t2, 0($sp)		#pop
	addi $sp, $sp, 4
	beq $t1, 41, pop1
	beq $t1, 93, pop2
	beq $t1, 125, pop3
	addi $sp, $sp, -4	#huy pop
	j loop3
pop1:
	bgt $sp, $t0,empty
	bne $t2, 40, error
	j loop3
pop2:
	bgt $sp, $t0,empty
	bne $t2, 91, error
	j loop3
pop3:
	bgt $sp, $t0,empty
	bne $t2, 123, error
	j loop3
error:	#loi 1 hoac 2
	addi $v1, $zero, 1
	j end_check_brackets
check_empty:	#loi 0 hoac 3
	beq $sp, $t0, no_error	#stack empty thi ket thuc
	addi $v1, $zero, 3
	j end_check_brackets
empty:
	li $v1,2
	j end_check_brackets
no_error:
	li $v0,0
end_check_brackets:
	move $sp, $t0 	#khoi phuc stack
	jr $ra
	
# draw_hist: ve pho diem bang ky tu |
# input : $a0 = dia chi mang hist, $a1 = so nhom (4)
# output: khong co (in ra man hinh)
draw_hist:
	move $t2, $a0		
	move $t3, $a1		# so nhom
	li   $t0, 0		# i = 0
loop4:
	beq  $t0, $t3, end_draw_hist
	li   $v0, 11		# in nhan "gi: " 
	li   $a0, 'g'
	syscall
	addi $a0, $t0, 48	# chu so nhom 
	syscall
	li   $a0, ':'
	syscall
	li   $a0, ' '
	syscall
	lw   $t1, 0($t2)	# so luong can in
	addi $t2, $t2, 4	# sang phan tu hist ke tiep
	addi $t0, $t0, 1	# i++
draw:
	beq  $t1, $zero, xuong_dong
	addi $t1, $t1, -1
	li   $a0, '|'
	syscall
	j    draw
xuong_dong:
	li   $a0, 10
	syscall			# xuong dong
	j loop4
end_draw_hist:
	jr   $ra
